{
  "name": "web",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#.storybook/preview": "./.storybook/preview.ts"
  },
  "scripts": {
    "install:browsers": "pnpm exec playwright install --with-deps",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "shadcn": "shadcn",
    "msw:init": "msw init",
    "lint": "pnpm exec eslint --fix --max-warnings=0 --ext js,jsx,ts,tsx app --cache --cache-location ./node_modules/.cache/eslint .",
    "lint-dry": "pnpm exec eslint --fix-dry-run --max-warnings=0 --ext js,jsx,ts,tsx app --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --ignore-path ../../.gitignore --ignore-path .gitignore --ignore-path .prettierignore --write \"**/*.{ts,tsx,html,md,mdx,css,json}\"",
    "knip": "knip",
    "stylelint": "stylelint --fix app/**/*.css",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:ci": "vitest --run --passWithNoTests --coverage --bail 1",
    "test:lint-staged": "vitest --run --changed --passWithNoTests --bail 1",
    "pw": "pnpm build-storybook && pnpm exec playwright test",
    "pw-ui": "pnpm build-storybook && pnpm exec playwright test --ui",
    "chromatic": "pnpm exec chromatic --auto-accept-changes 'main' --storybook-build-dir 'storybook-static' --only-changed --exit-once-uploaded --exit-zero-on-changes --skip '@(renovate/**|dependabot/**)'",
    "storybook": "bash ../../.gaia/scripts/storybook-launch.sh",
    "build-storybook": "storybook build --test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "cookie": "2.0.2",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "i18next": "27.1.2",
    "i18next-browser-languagedetector": "8.3.0",
    "isbot": "5.2.3",
    "ky": "2.2.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.73.0",
    "nanoid": "6.0.2",
    "query-string": "10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "remix-i18next": "8.0.0",
    "remix-toast": "4.0.0",
    "remix-utils": "10.0.1",
    "spark-md5": "3.0.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@faker-js/faker": "10.6.0",
    "@gaia-harness/lint": "3.2.1",
    "@msw/data": "1.1.8",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/accept-language-parser": "1.5.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spark-md5": "3.0.5",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vueless/storybook-dark-mode": "10.0.8",
    "accept-language-parser": "1.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bippy": "0.7.3",
    "chromatic": "18.14.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "knip": "6.45.1",
    "msw": "3.0.6",
    "msw-storybook-addon": "3.0.3",
    "node-html-parser": "9.0.7",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "storybook-react-i18next": "10.1.4",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
