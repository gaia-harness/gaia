{
  "name": "gaia",
  "version": "2.3.1",
  "description": "GAIA: A serious harness for Claude Code",
  "author": "Steven Sacks <stevensacks@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "private": true,
  "gaia": {
    "updateDepsHold": {
      "typescript": "6.0"
    },
    "wikiClassify": {
      "sourcePaths": [
        ".claude/agents/",
        ".claude/commands/",
        ".claude/hooks/",
        ".claude/rules/",
        ".claude/skills/",
        ".gaia/cli/src/",
        ".gaia/scripts/",
        ".gaia/statusline/",
        "apps/web/app/"
      ],
      "testPaths": [
        ".gaia/tests/",
        ".gaia/scripts/tests/"
      ]
    }
  },
  "bin": {
    "gaia": "./.gaia/cli/gaia"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || [ ! -e .git ] || git config core.hooksPath .githooks",
    "lint:cli": "pnpm -C .gaia/cli lint",
    "test:forensics": "bash .gaia/tests/forensics/run-all.sh",
    "test:sandbox": "bash .gaia/tests/sandbox/run-all.sh",
    "test:shell": "sh .gaia/scripts/test-shell.sh",
    "install:browsers": "pnpm -C apps/web install:browsers",
    "build": "pnpm -C apps/web build",
    "dev": "pnpm -C apps/web dev",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -r --if-present --no-bail run lint",
    "lint-dry": "pnpm -C apps/web lint-dry",
    "format": "prettier --write \"**/*.{ts,tsx,html,md,mdx,css,json}\" && pnpm -C apps/web format",
    "knip": "pnpm -C apps/web knip",
    "stylelint": "pnpm -C apps/web stylelint",
    "typecheck": "pnpm -r --if-present --no-bail run typecheck",
    "test": "pnpm -C apps/web test",
    "test:ci": "pnpm -r --if-present --no-bail --workspace-concurrency=1 run test:ci",
    "test:lint-staged": "pnpm -C apps/web test:lint-staged",
    "pw": "pnpm -C apps/web pw",
    "pw-ui": "pnpm -C apps/web pw-ui",
    "chromatic": "pnpm -C apps/web chromatic",
    "storybook": "pnpm -C apps/web storybook",
    "build-storybook": "pnpm -C apps/web build-storybook",
    "shadcn": "pnpm -C apps/web shadcn"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@gaia-harness/lint": "3.1.1",
    "bats": "1.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
