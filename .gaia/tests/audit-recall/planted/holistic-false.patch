new file mode 100644
--- /dev/null
+++ b/frontend/app/utils/average.ts
@@ -0,0 +1,9 @@
+const mean = (values: number[]): number =>
+  values.reduce((sum, value) => sum + value, 0) / values.length;
+
+/** The mean of `values`, or 0 for an empty list. */
+export const averageOrZero = (values: number[]): number => {
+  if (values.length === 0) return 0;
+
+  return mean(values);
+};
diff --git a/frontend/app/utils/page.ts b/frontend/app/utils/page.ts
new file mode 100644
--- /dev/null
+++ b/frontend/app/utils/page.ts
@@ -0,0 +1,14 @@
+import {z} from 'zod';
+
+const pageSchema = z.coerce.number().int().min(1).max(500);
+
+/** The 1-based page a `page` search parameter names, defaulting to 1. */
+export const parsePage = (raw: null | string): number => {
+  const parsed = pageSchema.safeParse(raw ?? '1');
+
+  return parsed.success ? parsed.data : 1;
+};
+
+/** The row offset of the page a `page` search parameter names. */
+export const pageOffset = (raw: null | string, pageSize: number): number =>
+  (parsePage(raw) - 1) * pageSize;
diff --git a/frontend/app/utils/tests/average.test.ts b/frontend/app/utils/tests/average.test.ts
new file mode 100644
--- /dev/null
+++ b/frontend/app/utils/tests/average.test.ts
@@ -0,0 +1,12 @@
+import {describe, expect, test} from 'vitest';
+import {averageOrZero} from '../average';
+
+describe('averageOrZero', () => {
+  test('an empty list averages to zero, never NaN', () => {
+    expect(averageOrZero([])).toBe(0);
+  });
+
+  test('a non-empty list averages its values', () => {
+    expect(averageOrZero([2, 4, 9])).toBe(5);
+  });
+});
diff --git a/frontend/app/utils/tests/page.test.ts b/frontend/app/utils/tests/page.test.ts
new file mode 100644
--- /dev/null
+++ b/frontend/app/utils/tests/page.test.ts
@@ -0,0 +1,15 @@
+import {describe, expect, test} from 'vitest';
+import {pageOffset} from '../page';
+
+describe('pageOffset', () => {
+  test('a page parameter below 1, or not a number, reads as page 1', () => {
+    expect(pageOffset('0', 10)).toBe(0);
+    expect(pageOffset('-3', 10)).toBe(0);
+    expect(pageOffset('abc', 10)).toBe(0);
+    expect(pageOffset(null, 10)).toBe(0);
+  });
+
+  test('a valid page parameter offsets by whole pages', () => {
+    expect(pageOffset('3', 10)).toBe(20);
+  });
+});
