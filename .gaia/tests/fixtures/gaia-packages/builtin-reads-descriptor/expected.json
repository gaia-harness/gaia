{
  "load": 0,
  "source": "builtin",
  "list": [["web", "apps/web"]],
  "globs": {
    "tddUnitTests": {
      "match": ["apps/web/src/x.test.ts"],
      "noMatch": ["apps/web/app/x.test.ts"]
    },
    "tddStrictCandidates": {
      "match": ["apps/web/src/lib/x.ts"],
      "noMatch": ["apps/web/app/utils/x.ts"]
    },
    "preCommitSource": {
      "match": ["apps/web/src/x.ts"],
      "noMatch": ["apps/web/app/x.ts"]
    }
  },
  "forPath": {
    "apps/web/src/x.ts": "web"
  },
  "dir": {
    "web": "apps/web"
  }
}
