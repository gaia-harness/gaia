import {http, HttpResponse} from 'msw/http';
import {{{NAME_UPPER}}_URLS} from '~/services/{{layer}}/{{name}}/urls';
import {url} from '../url';
import {{{plural}}, server{{Singular}}Schema} from './data';

export default http.post(url({{NAME_UPPER}}_URLS.{{plural}}), async ({request}) => {
  const body = (await request.json()) as Record<string, unknown>;
  const parsed = server{{Singular}}Schema.safeParse({
    ...body,
    id: body.id ?? crypto.randomUUID(),
  });

  if (!parsed.success) {
    return HttpResponse.json(
      {error: 'Invalid {{singular}}', issues: parsed.error.issues},
      {status: 400}
    );
  }

  const data = await {{plural}}.create(parsed.data);

  return HttpResponse.json({data});
});
