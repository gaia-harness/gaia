import {http, HttpResponse} from 'msw/http';
import {{{NAME_UPPER}}_URLS} from '~/services/{{layer}}/{{name}}/urls';
import {url} from '../url';
import {{{plural}}, server{{Singular}}Schema} from './data';

export default http.put(
  url({{NAME_UPPER}}_URLS.{{plural}}Id),
  async ({params, request}) => {
    const parsed = server{{Singular}}Schema
      .partial()
      .safeParse(await request.json());

    if (!parsed.success) {
      return HttpResponse.json(
        {error: 'Invalid {{singular}}', issues: parsed.error.issues},
        {status: 400}
      );
    }

    const data = await {{plural}}.update(
      (q) => q.where({id: String(params.id)}),
      {
        data(record) {
          Object.assign(record, parsed.data);
        },
      }
    );

    return HttpResponse.json({data});
  }
);
