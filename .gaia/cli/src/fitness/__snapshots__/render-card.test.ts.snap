exports[`renderCard > renders a mixed report 1`] = `
"+--------------------------------------------------------------------------------------------------+
| GAIA FITNESS                                                                       OVERALL   C+  |
+--------------------------------------------------------------------------------------------------+
| authoring                                                                                    A+  |
| claudemd                                                                                     A+  |
| frontmatter                                                                      1 warning   B+  |
| hooks                                                                              1 error   C+  |
| prompt                                                                                       A+  |
| rules                                                                                        A+  |
| settings                                                                 1 warning, 1 info   B   |
| wiki                                                                                         A+  |
+--------------------------------------------------------------------------------------------------+
| FINDINGS                                                                                         |
|                                                                                                  |
| frontmatter: B+                                                                                  |
|   [warning] .claude/commands/example.md:2                                                        |
|             frontmatter.command.description                                                      |
|             description frontmatter is missing; add a concise description of what this command   |
|             does.                                                                                |
|                                                                                                  |
| hooks: C+                                                                                        |
|   [error]   .claude/settings.json:14                                                             |
|             hooks.script-missing                                                                 |
|             Point the hook at a script that exists.                                              |
|                                                                                                  |
| settings: B                                                                                      |
|   [warning] .claude/settings.json                                                                |
|             settings.permissions.redundant                                                       |
|             Drop the redundant permission entry.                                                 |
|   [info]    .claude/settings.json:3                                                              |
|             settings.permissions.broad                                                           |
|             Consider narrowing this entry.                                                       |
+--------------------------------------------------------------------------------------------------+"
`;

